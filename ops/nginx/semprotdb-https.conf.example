# Replace 70-semprotdb.conf with this only after the certificate exists.
# The certificate must cover both semprotdb.org and www.semprotdb.org.
server {
  listen 80;
  listen [::]:80;
  server_name semprotdb.org www.semprotdb.org;
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name semprotdb.org www.semprotdb.org;
  ssl_certificate /etc/letsencrypt/live/semprotdb.org/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/semprotdb.org/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SEMPROTDBTLS:10m;
  ssl_session_timeout 1d;
  include /etc/nginx/snippets/semprotdb-locations.conf;
}
