# Copy to .env in the repository root. Keep .env only on the server.
# PostgreSQL is an existing container on platform_database (not localhost).
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/semprotdb
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Internal HTTP port. Keep 3001 to match the Locaweb Nginx upstream.
# Published host port is 2929.
SERVER_PORT=3001

# Required: generate with openssl rand -base64 64.
# To preserve existing sessions, securely reuse the current production secret.
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# Optional JVM tuning; adjust to the application's workload and VM capacity.
# JAVA_TOOL_OPTIONS=-Xms256m -Xmx1g
# Optional mail configuration (if used):
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# JHIPSTER_MAIL_BASE_URL=https://semprotdb.org
